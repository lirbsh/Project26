<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:Project26.ViewModels"
             xmlns:gn="clr-namespace:Project26.General"
             x:Class="Project26.Views.AuthPage"
             x:DataType="vm:AuthPageVM">
    <Grid RowDefinitions="Auto,Auto,*" RowSpacing="10">
        <Label Text="{x:Static gn:Strings.Auth}"
               Opacity="{Binding AnimationOpacity}"
               FontSize="24"
               HorizontalOptions="Center"
               VerticalOptions="Center" />
        <Label Text="{Binding UserStateAction}"
               FontAttributes="Bold"
               TextColor="Blue"
               Grid.Row="1"
               FontSize="18"
               HorizontalOptions="Center"
               VerticalOptions="Center" />
        <StackLayout Grid.Row="2"
                     Padding="20"
                     Spacing="10">
            <Entry Placeholder="{x:Static gn:Strings.Name}"
                   Text="{Binding Name}" Keyboard="Text" ReturnType="Next"/>
            <Entry Placeholder="{x:Static gn:Strings.Email}"
                   Text="{Binding Email}" Keyboard="Email" ReturnType="Next"/>
            <Entry Placeholder="{x:Static gn:Strings.Password}"
                   IsPassword="True"
                   Text="{Binding Password}" Keyboard="Text" ReturnType="Done"/>
            <Button Text="{x:Static gn:Strings.Login}"
                    Command="{Binding SignInCommand}" />
            <Button Text="{x:Static gn:Strings.Register}"
                    Command="{Binding CreateUserCommand}" />
            <Button Text="{x:Static gn:Strings.Quit}"
                    Command="{Binding QuitCommand}" />
            <Label Text="{Binding Status}"
                FontSize="24"
                HorizontalOptions="Center"
                VerticalOptions="Center" />
        </StackLayout>
    </Grid>
</ContentPage>